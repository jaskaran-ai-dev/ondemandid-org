#!/bin/sh

# Enforce bun as the only allowed package manager.
# Rejects commits that include pnpm, npm, or yarn lockfiles.

FORBIDDEN_FILES="pnpm-lock.yaml package-lock.json yarn.lock"

for file in $FORBIDDEN_FILES; do
  if git diff --cached --name-only --diff-filter=ACR | grep -q "^$file$"; then
    echo "ERROR: '$file' is staged for commit. This project uses bun only."
    echo "  Remove it: git rm --cached $file (if tracked)"
    echo "  Or delete the file and use 'bun install' instead."
    exit 1
  fi
done

if ! git diff --cached --name-only --diff-filter=ACR | grep -q "^bun.lock$"; then
  # bun.lock not staged — warn but don't block if the file exists on disk
  if [ ! -f bun.lock ]; then
    echo "ERROR: bun.lock is missing. Run 'bun install' to generate it."
    exit 1
  fi
fi
